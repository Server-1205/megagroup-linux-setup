client
verb 3
dev tun
proto udp
remote gnome2.megagroup.ru 443
connect-retry-max 5
resolv-retry 60
auth-user-pass /etc/openvpn/client/megagroup.auth

# Compatibility with OpenVPN 2.5 / 2.6 / 2.7 (Megagroup legacy BF-CBC cipher)
data-ciphers DEFAULT:BF-CBC
data-ciphers-fallback BF-CBC

# Linux DNS & systemd-resolved integration
script-security 2
up /etc/openvpn/update-systemd-resolved
down /etc/openvpn/update-systemd-resolved
down-pre
dhcp-option DOMAIN-ROUTE .

